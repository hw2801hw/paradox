<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <!-- 針對手機直向 9:16 比例最佳化 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <title>字母順序 Alphabet Order</title>

    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>

    <style>
        /* ========== 重設與基礎樣式 ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang TC", "Microsoft JhengHei", "Helvetica Neue", Arial, sans-serif;
            background: #0f172a;
            color: #f1f5f9;
            font-size: 16px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(ellipse at top, #1e293b 0%, #0f172a 50%, #020617 100%);
            position: relative;
        }

        /* 背景星星動畫 */
        .stars {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            animation: twinkle 3s infinite ease-in-out;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.2); }
        }

        /* ========== 應用程式容器 ========== */
        .app {
            position: relative;
            width: 100svw;
            height: 100svh;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            padding: env(safe-area-inset-top, 12px) 16px env(safe-area-inset-bottom, 12px);
            z-index: 1;
        }

        .screen {
            display: none;
            flex-direction: column;
            width: 100%;
            height: 100%;
            animation: fadeIn 0.4s ease-out;
        }

        .screen.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pop {
            0% { transform: scale(0.5); opacity: 0; }
            60% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        /* ========== 開始畫面 ========== */
        .start-screen {
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 20px;
            padding: 20px;
        }

        .logo {
            font-size: clamp(44px, 11svmin, 76px);
            font-weight: 900;
            background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 50%, #f472b6 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 2px;
            margin-bottom: 4px;
            animation: pulse 3s ease-in-out infinite;
        }

        .subtitle {
            font-size: clamp(16px, 4svmin, 20px);
            color: #94a3b8;
            font-weight: 500;
            margin-bottom: 10px;
        }

        .info-box {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 16px;
            padding: 16px;
            width: 100%;
            max-width: 360px;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .info-box p {
            font-size: clamp(16px, 4svmin, 18px);
            color: #cbd5e1;
            margin: 0;
        }

        .info-box .emoji {
            font-size: 1.1em;
            margin-right: 8px;
        }

        .divider {
            width: 100%;
            max-width: 360px;
            display: flex;
            align-items: center;
            text-align: center;
            color: #475569;
            font-size: 16px;
            margin: 8px 0;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(148, 163, 184, 0.15);
        }

        .divider:not(:empty)::before {
            margin-right: .5em;
        }

        .divider:not(:empty)::after {
            margin-left: .5em;
        }

        .exam-box {
            background: rgba(30, 41, 59, 0.4);
            border: 1px dashed rgba(148, 163, 184, 0.25);
            border-radius: 16px;
            padding: 16px;
            width: 100%;
            max-width: 360px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .room-input {
            width: 100%;
            padding: 12px;
            font-size: 18px;
            background: rgba(15, 23, 42, 0.6);
            border: 1.5px solid rgba(148, 163, 184, 0.2);
            border-radius: 12px;
            color: #f1f5f9;
            text-align: center;
            outline: none;
            transition: all 0.2s;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .room-input:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
        }

        .room-input::placeholder {
            color: #475569;
            letter-spacing: 0;
            font-weight: 400;
        }

        .btn {
            width: 100%;
            max-width: 360px;
            padding: 16px 24px;
            border: none;
            border-radius: 16px;
            font-size: clamp(18px, 4.5svmin, 20px);
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
            min-height: 54px;
            color: white;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:active {
            transform: scale(0.97);
        }

        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
        }

        .btn-accent {
            background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
            box-shadow: 0 6px 20px rgba(236, 72, 153, 0.3);
        }

        .btn-secondary {
            background: rgba(71, 85, 105, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.3);
            color: #e2e8f0;
        }

        /* ========== 等待對手畫面 ========== */
        .waiting-screen {
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 24px;
            padding: 20px;
        }

        .room-tag {
            font-size: clamp(24px, 6svmin, 32px);
            font-weight: 800;
            background: rgba(59, 130, 246, 0.2);
            border: 1.5px solid rgba(96, 165, 250, 0.4);
            color: #60a5fa;
            padding: 10px 24px;
            border-radius: 99px;
            display: inline-block;
            letter-spacing: 1px;
        }

        .player-slots {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
            max-width: 320px;
            margin: 20px 0;
        }

        .player-slot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            background: rgba(30, 41, 59, 0.6);
            border: 1.5px dashed rgba(148, 163, 184, 0.2);
            border-radius: 16px;
            font-size: 18px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .player-slot.filled {
            border-style: solid;
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
        }

        .player-slot .status-indicator {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #94a3b8;
        }

        .dot.active {
            background: #22c55e;
            box-shadow: 0 0 8px #22c55e;
            animation: pulse 1.5s infinite;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255,255,255,0.1);
            border-left-color: #60a5fa;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 10px auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ========== 測驗畫面 ========== */
        .quiz-screen {
            padding-top: 10px;
        }

        /* 單人模式 HUD */
        .single-hud {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            font-size: clamp(16px, 4svmin, 18px);
            color: #94a3b8;
        }

        .single-hud .score {
            color: #fbbf24;
            font-weight: 700;
        }

        .single-progress-bar {
            width: 100%;
            height: 8px;
            background: rgba(71, 85, 105, 0.4);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 4px;
            margin-bottom: 16px;
        }

        .single-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 100%);
            border-radius: 4px;
            width: 0%;
            transition: width 0.4s ease;
        }

        /* 雙人對戰 HUD */
        .battle-hud {
            display: none;
            grid-template-columns: 1fr 40px 1fr;
            align-items: center;
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 16px;
            padding: 12px;
            margin-bottom: 16px;
            gap: 8px;
        }

        .hud-player {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .hud-player.left {
            text-align: left;
        }

        .hud-player.right {
            text-align: right;
        }

        .hud-name {
            font-size: clamp(16px, 4svmin, 18px);
            font-weight: 700;
            color: #e2e8f0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 110px;
        }

        .hud-score {
            font-size: clamp(18px, 4.5svmin, 22px);
            font-weight: 800;
            color: #fbbf24;
        }

        .hud-progress {
            font-size: 14px;
            color: #94a3b8;
        }

        .hud-vs {
            text-align: center;
            font-weight: 900;
            font-size: 16px;
            color: #f472b6;
            text-shadow: 0 0 8px rgba(244, 114, 182, 0.5);
        }

        .hud-progress-container {
            width: 100%;
            height: 4px;
            background: rgba(71, 85, 105, 0.4);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 4px;
        }

        .hud-progress-fill {
            height: 100%;
            background: #3b82f6;
            width: 0%;
            transition: width 0.3s ease;
        }

        .hud-player.right .hud-progress-fill {
            background: #a78bfa;
            float: right;
        }

        /* 計時器 */
        .timer-container {
            width: 100%;
            margin-bottom: 16px;
        }

        .timer-bar {
            width: 100%;
            height: 8px;
            background: rgba(71, 85, 105, 0.4);
            border-radius: 4px;
            overflow: hidden;
        }

        .timer-fill {
            height: 100%;
            width: 100%;
            background: #22c55e;
            border-radius: 4px;
            transition: width 0.1s linear, background-color 0.3s;
        }

        .timer-text {
            text-align: center;
            font-size: clamp(18px, 4.5svmin, 22px);
            font-weight: 700;
            margin-top: 4px;
            color: #22c55e;
            transition: color 0.3s;
        }

        /* 題目顯示區域 */
        .question-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 12px;
        }

        .question-text {
            font-size: clamp(18px, 4.5svmin, 22px);
            color: #cbd5e1;
            line-height: 1.4;
            padding: 0 10px;
        }

        .letter-display {
            font-size: clamp(130px, 32svmin, 200px);
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 40px rgba(96, 165, 250, 0.3);
            margin: 4px 0;
            animation: pop 0.5s ease-out;
            font-family: "Georgia", "Times New Roman", serif;
        }

        /* 輸入區域 */
        .input-area {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .number-input {
            width: 100%;
            max-width: 200px;
            padding: 14px;
            font-size: clamp(24px, 6svmin, 32px);
            text-align: center;
            background: rgba(30, 41, 59, 0.8);
            border: 2px solid rgba(148, 163, 184, 0.3);
            border-radius: 12px;
            color: #f1f5f9;
            font-weight: 700;
            font-family: inherit;
            outline: none;
            transition: all 0.2s;
            -moz-appearance: textfield; /* 移除 Firefox 的上下箭頭 */
        }

        /* 移除 Chrome/Safari 的上下箭頭 */
        .number-input::-webkit-outer-spin-button,
        .number-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .number-input:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
        }

        .number-input::placeholder {
            color: #475569;
        }

        .submit-btn {
            width: 100%;
            max-width: 200px;
            padding: 12px;
            font-size: clamp(18px, 4.5svmin, 20px);
        }

        /* 反饋彈窗 */
        .feedback {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 24px 36px;
            border-radius: 20px;
            font-size: clamp(22px, 5.5svmin, 28px);
            font-weight: 700;
            text-align: center;
            z-index: 100;
            animation: pop 0.3s ease-out;
            display: none;
            min-width: 220px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        }

        .feedback.show {
            display: block;
        }

        .feedback.correct {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            color: white;
        }

        .feedback.wrong {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .feedback .answer {
            display: block;
            font-size: 0.7em;
            margin-top: 8px;
            font-weight: 500;
            opacity: 0.95;
        }

        /* ========== 結束畫面 ========== */
        .end-screen {
            justify-content: center;
            align-items: center;
            text-align: center;
            gap: 16px;
            padding: 20px;
        }

        .trophy {
            font-size: clamp(70px, 18svmin, 100px);
            animation: pulse 2s ease-in-out infinite;
        }

        .end-title {
            font-size: clamp(24px, 6svmin, 32px);
            font-weight: 800;
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* 單人模式成績盒 */
        .score-box {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 20px;
            padding: 20px;
            width: 100%;
            max-width: 320px;
            display: flex;
            flex-direction: column;
        }

        .score-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            font-size: clamp(18px, 4.5svmin, 22px);
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
        }

        .score-row:last-child {
            border-bottom: none;
        }

        .score-row .label {
            color: #94a3b8;
        }

        .score-row .value {
            font-weight: 700;
            color: #fbbf24;
            font-size: 1.1em;
        }

        .correct-count {
            color: #22c55e !important;
        }

        .end-message {
            font-size: clamp(16px, 4svmin, 20px);
            color: #cbd5e1;
            margin-top: 4px;
        }

        /* 雙人模式對戰成績盒 */
        .battle-results {
            width: 100%;
            max-width: 360px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin: 10px 0;
        }

        .result-card {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            position: relative;
        }

        .result-card.winner {
            border-color: #fbbf24;
            background: rgba(251, 191, 36, 0.1);
        }

        .result-card.winner::after {
            content: "🏆 WINNER";
            position: absolute;
            top: -10px;
            right: 15px;
            background: #fbbf24;
            color: #0f172a;
            font-size: 12px;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 4px;
        }

        .result-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            padding-bottom: 6px;
        }

        .result-name {
            font-size: 18px;
            font-weight: 700;
        }

        .result-stats {
            display: flex;
            justify-content: space-between;
            font-size: 16px;
            color: #cbd5e1;
        }

        .result-val {
            font-weight: 700;
            color: #60a5fa;
        }

        .result-score {
            font-size: 20px;
            font-weight: 800;
            color: #fbbf24;
        }

        /* 粒子動畫 */
        .particle {
            position: fixed;
            pointer-events: none;
            font-size: 24px;
            z-index: 50;
            animation: particleFly 1.2s ease-out forwards;
        }

        @keyframes particleFly {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(1) rotate(0deg);
            }
            100% {
                opacity: 0;
                transform: translate(var(--tx), var(--ty)) scale(0.3) rotate(360deg);
            }
        }

        /* RWD 微調 */
        @media (max-height: 640px) {
            .logo { font-size: 32px; }
            .letter-display { font-size: 85px; }
            .info-box { padding: 12px; gap: 4px; }
            .exam-box { padding: 12px; gap: 6px; }
        }

        @media (min-aspect-ratio: 1/1) {
            .app { max-width: 500px; }
        }
    </style>
</head>
<body>
    <!-- 背景星星 -->
    <div class="stars" id="stars"></div>

    <div class="app">
        <!-- ========== 開始畫面 ========== -->
        <div class="screen start-screen active" id="startScreen">
            <div class="logo">字母順序</div>
            <div class="subtitle">Alphabet Order</div>
            
            <div class="info-box">
                <p><span class="emoji">📝</span>共 10 題測驗</p>
                <p><span class="emoji">⏱️</span>每題 8 秒作答</p>
                <p><span class="emoji">🎯</span>答對 +10 分</p>
            </div>

            <button class="btn btn-primary" id="startBtn">開始測驗</button>

            <div class="divider">或</div>

            <div class="exam-box">
                <input type="number" id="roomCodeInput" class="room-input" placeholder="輸入 4 位數房號" pattern="[0-9]*" inputmode="numeric">
                <button class="btn btn-accent" id="joinRoomBtn">進入房間 / 全場考試</button>
            </div>
        </div>

        <!-- ========== 等待對手畫面 ========== -->
        <div class="screen waiting-screen" id="waitingScreen">
            <div class="logo" style="font-size: 28px;">等待對手</div>
            <div class="room-tag" id="roomDisplay">房號: ----</div>
            
            <div class="spinner"></div>
            <p style="color: #94a3b8; font-size: 16px;">正在等待另一位玩家加入以開始考試...</p>

            <div class="player-slots">
                <div class="player-slot" id="slotPlayer1">
                    <span class="player-name-text">玩家 1 (你)</span>
                    <span class="status-indicator"><div class="dot active"></div>連線中</span>
                </div>
                <div class="player-slot" id="slotPlayer2">
                    <span class="player-name-text" style="color: #64748b;">等待對手加入...</span>
                    <span class="status-indicator"><div class="dot"></div>未就緒</span>
                </div>
            </div>

            <button class="btn btn-secondary" id="leaveRoomBtn">離開房間</button>
        </div>

        <!-- ========== 測驗畫面 ========== -->
        <div class="screen quiz-screen" id="quizScreen">
            <!-- 單人模式 HUD -->
            <div class="single-hud" id="singleHud">
                <span id="progressText">第 1 / 10 題</span>
                <span>分數: <span class="score" id="currentScore">0</span></span>
            </div>
            <div class="single-progress-bar" id="singleProgressBar">
                <div class="single-progress-fill" id="progressFill"></div>
            </div>

            <!-- 雙人對戰 HUD -->
            <div class="battle-hud" id="battleHud">
                <div class="hud-player left">
