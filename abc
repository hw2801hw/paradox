        };

        // ==========================================
        // Web Audio API 音效模組
        // ==========================================
        let audioCtx = null;

        function getAudioContext() {
            if (!audioCtx) {
                try {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {
                    console.log('不支援音效');
                }
            }
            return audioCtx;
        }

        function playTone(freq, duration, type = 'sine', volume = 0.2) {
            const ctx = getAudioContext();
            if (!ctx) return;
            try {
                const oscillator = ctx.createOscillator();
                const gainNode = ctx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(ctx.destination);
                oscillator.type = type;
                oscillator.frequency.value = freq;
                gainNode.gain.setValueAtTime(volume, ctx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
                oscillator.start();
                oscillator.stop(ctx.currentTime + duration);
            } catch (e) {
                // 忽略錯誤
            }
        }

        const sfx = {
            correct: () => {
                playTone(523.25, 0.15, 'sine', 0.25); // C5
                setTimeout(() => playTone(659.25, 0.15, 'sine', 0.25), 100); // E5
                setTimeout(() => playTone(783.99, 0.3, 'sine', 0.25), 200); // G5
            },
            wrong: () => {
                playTone(220, 0.2, 'sawtooth', 0.15); // A3
                setTimeout(() => playTone(174.61, 0.3, 'sawtooth', 0.15), 150); // F3
            },
            tick: () => {
                playTone(800, 0.05, 'sine', 0.08);
            },
            start: () => {
                playTone(440, 0.1, 'sine', 0.2);
                setTimeout(() => playTone(554.37, 0.1, 'sine', 0.2), 100);
                setTimeout(() => playTone(659.25, 0.15, 'sine', 0.2), 200);
            },
            end: () => {
                playTone(523.25, 0.15, 'sine', 0.2);
                setTimeout(() => playTone(659.25, 0.15, 'sine', 0.2), 150);
                setTimeout(() => playTone(783.99, 0.15, 'sine', 0.2), 300);
                setTimeout(() => playTone(1046.5, 0.4, 'sine', 0.2), 450);
            }
        };

        // ==========================================
        // 背景裝飾星星
        // ==========================================
        function createStars() {
            const count = 40;
            els.stars.innerHTML = '';
            for (let i = 0; i < count; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                const size = Math.random() * 2 + 1;
                star.style.width = size + 'px';
                star.style.height = size + 'px';
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.animationDelay = Math.random() * 3 + 's';
                star.style.animationDuration = (Math.random() * 2 + 2) + 's';
                els.stars.appendChild(star);
            }
        }

        // ==========================================
        // 畫面切換
        // ==========================================
        function showScreen(screenName) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenName).classList.add('active');
        }

        // ==========================================
        // 核心對焦對策：讓手機虛擬鍵盤自動彈出並維持對焦
        // ==========================================
        function forceFocusInput() {
            els.numberInput.focus();
            // 部分手機瀏覽器對非同步的 focus 限制極嚴，使用雙重對焦確保喚醒
            setTimeout(() => {
                els.numberInput.focus();
            }, 50);
        }

        // ==========================================
        // 雙人考試 (Realtime Database) 邏輯
        // ==========================================
        async function joinRoom() {
            let roomCode = els.roomCodeInput.value.trim();

            if (!roomCode || roomCode.length !== 4) {
                alert('請輸入正確的 4 位數房號！');
                return;
            }

            state.isMultiplayer = true;
            state.roomCode = roomCode;

            showScreen('waitingScreen');
            els.roomDisplay.textContent = `房號: ${roomCode}`;
            
            els.slotPlayer1.querySelector('.player-name-text').textContent = `玩家 1 (你)`;

            state.roomRef = db.ref(`rooms/${roomCode}`);
            
            state.roomRef.transaction((currentData) => {
                if (currentData === null) {
                    // 創建房間，作為 Player 1
                    const questions = generateRandomQuestions();
                    state.playerRole = 'player1';
                    return {
                        status: 'waiting',
                        questions: questions,
                        createdAt: firebase.database.ServerValue.TIMESTAMP,
                        players: {
                            [state.playerId]: {
                                role: 'player1',
                                score: 0,
                                progress: 0,
                                finished: false,
                                correct: 0,
                                joinedAt: firebase.database.ServerValue.TIMESTAMP
                            }
                        }
                    };
                } else {
                    // 房間已存在，檢查人數
                    const playerIds = Object.keys(currentData.players || {});
                    if (playerIds.length >= 2) {
                        return; // 房間滿了，取消事務
                    }
                    
                    // 作為 Player 2 加入
                    state.playerRole = 'player2';
                    currentData.players[state.playerId] = {
                        role: 'player2',
                        score: 0,
                        progress: 0,
                        finished: false,
                        correct: 0,
                        joinedAt: firebase.database.ServerValue.TIMESTAMP
                    };
                    
                    currentData.status = 'playing';
                    return currentData;
                }
            }, (error, committed, snapshot) => {
                if (error) {
                    alert('連線失敗，請重試！');
                    showScreen('startScreen');
                } else if (!committed) {
                    alert('此房間人已經滿了喔！請輸入其他房號。');
                    showScreen('startScreen');
                } else {
                    listenToRoom();
                }
            });
        }

        function generateRandomQuestions() {
            const pool = [];
            for (let i = 0; i < 26; i++) pool.push(i);
            
            const selected = [];
            for (let i = 0; i < 10; i++) {
                const idx = Math.floor(Math.random() * pool.length);
                selected.push(pool.splice(idx, 1)[0]);
            }
            return selected;
        }

        function listenToRoom() {
            state.roomRef.on('value', (snapshot) => {
                const data = snapshot.val();
                if (!data) return;

                const playerIds = Object.keys(data.players || {});
                const me = data.players[state.playerId];
                const opponentId = playerIds.find(id => id !== state.playerId);
                const opponent = opponentId ? data.players[opponentId] : null;

                if (me) {
                    state.playerRole = me.role;
                }

                // 更新等待大廳畫面
                if (state.playerRole === 'player1') {
                    els.slotPlayer1.querySelector('.player-name-text').textContent = `玩家 1 (你)`;
                    if (opponent) {
                        els.slotPlayer2.classList.add('filled');
                        els.slotPlayer2.querySelector('.player-name-text').textContent = `玩家 2`;
                        els.slotPlayer2.querySelector('.dot').classList.add('active');
                        els.slotPlayer2.querySelector('.status-indicator').innerHTML = '<div class="dot active"></div>連線中';
                    } else {
                        els.slotPlayer2.classList.remove('filled');
                        els.slotPlayer2.querySelector('.player-name-text').textContent = '等待對手加入...';
                        els.slotPlayer2.querySelector('.dot').classList.remove('active');
                        els.slotPlayer2.querySelector('.status-indicator').innerHTML = '<div class="dot"></div>未就緒';
                    }
                } else {
                    els.slotPlayer1.querySelector('.player-name-text').textContent = `玩家 2 (你)`;
                    if (opponent) {
                        els.slotPlayer2.classList.add('filled');
                        els.slotPlayer2.querySelector('.player-name-text').textContent = `玩家 1`;
                        els.slotPlayer2.querySelector('.dot').classList.add('active');
                        els.slotPlayer2.querySelector('.status-indicator').innerHTML = '<div class="dot active"></div>連線中';
                    }
                }

                // 當房間狀態為 playing 時直接開始
                if (data.status === 'playing' && els.waitingScreen.classList.contains('active')) {
                    state.questions = data.questions;
                    startQuiz();
                }

                // 即時更新測驗中雙方的 HUD 進度與分數
                if (els.quizScreen.classList.contains('active') && state.isMultiplayer) {
                    // 我方 HUD
                    els.hudMyName.textContent = state.playerRole === 'player1' ? '玩家 1 (你)' : '玩家 2 (你)';
                    els.hudMyScore.textContent = me.score;
                    els.hudMyProgress.textContent = me.finished ? '完成！' : `第 ${me.progress} / 10 題`;
                    els.hudMyProgressFill.style.width = (me.progress / 10 * 100) + '%';

                    // 對手 HUD
                    if (opponent) {
                        els.hudOpponentName.textContent = opponent.role === 'player1' ? '玩家 1' : '玩家 2';
                        els.hudOpponentScore.textContent = opponent.score;
                        els.hudOpponentProgress.textContent = opponent.finished ? '完成！' : `第 ${opponent.progress} / 10 題`;
                        els.hudOpponentProgressFill.style.width = (opponent.progress / 10 * 100) + '%';
                    } else {
                        els.hudOpponentName.textContent = '已斷線';
                        els.hudOpponentScore.textContent = '-';
                        els.hudOpponentProgress.textContent = '已離開';
                    }

                    // 檢查雙方是否都已完成
                    const allFinished = playerIds.every(id => data.players[id].finished === true);
                    if (allFinished && data.status !== 'finished') {
                        state.roomRef.child('status').set('finished');
                    }
                }

                // 結束考試並顯示最終排行
                if (data.status === 'finished' && state.isMultiplayer) {
                    showEndScreen(data.players);
                }
            });

            // 斷線處理
            state.roomRef.child(`players/${state.playerId}`).onDisconnect().remove();
        }

        function leaveRoom() {
            if (state.roomRef) {
                state.roomRef.child(`players/${state.playerId}`).remove();
                state.roomRef.off();
                state.roomRef = null;
            }
            clearInterval(state.questionTimer);
            state.isMultiplayer = false;
            showScreen('startScreen');
        }

        // ==========================================
        // 測驗流程邏輯
        // ==========================================
        function startSinglePlayer() {
            state.isMultiplayer = false;
            state.questions = generateRandomQuestions();
            startQuiz();
        }

        function startQuiz() {
            sfx.start();
            showScreen('quizScreen');
            
            state.score = 0;
            state.correctCount = 0;
            state.currentQuestionIndex = 0;

            // 設置對應模式的 HUD 顯示
            if (state.isMultiplayer) {
                els.singleHud.style.display = 'none';
                els.singleProgressBar.style.display = 'none';
                els.battleHud.style.display = 'grid';
                updateFirebaseProgress();
            } else {
                els.singleHud.style.display = 'flex';
                els.singleProgressBar.style.display = 'block';
                els.battleHud.style.display = 'none';
                updateSingleHud();
            }

            nextQuestion();
        }

        function nextQuestion() {
            if (state.currentQuestionIndex >= state.totalQuestions) {
                state.isAnswering = false;
                clearInterval(state.questionTimer);

                if (state.isMultiplayer) {
                    // 雙人考試：等待對手完成
                    els.letterDisplay.textContent = '🏁';
                    els.questionText.innerHTML = '您已完成所有題目！<br>正在等待對手答題結束...';
                    els.numberInput.style.display = 'none';
                    els.submitBtn.style.display = 'none';
                    
                    state.roomRef.child(`players/${state.playerId}`).update({
                        finished: true
                    });
                } else {
                    // 單人考試：直接結算
                    showEndScreen();
                }
                return;
            }

            state.isAnswering = true;
            
            // 讀取對應英文字母
            const letterIndex = state.questions[state.currentQuestionIndex];
            state.currentLetter = String.fromCharCode(65 + letterIndex);
            state.currentAnswer = letterIndex + 1;

            // 更新介面與動畫
            els.numberInput.style.display = 'block';
            els.submitBtn.style.display = 'block';
            els.letterDisplay.textContent = state.currentLetter;
            els.letterDisplay.style.animation = 'none';
            void els.letterDisplay.offsetWidth; // 觸發重繪以重啟動畫
            els.letterDisplay.style.animation = 'pop 0.5s ease-out';

            els.numberInput.value = '';
            els.numberInput.disabled = false;
            els.submitBtn.disabled = false;

            if (state.isMultiplayer) {
                updateFirebaseProgress();
            } else {
                updateSingleHud();
            }

            // 【最核心】：新題目一出現，立即強制對焦輸入框，自動彈出手機虛擬鍵盤
            forceFocusInput();

            startQuestionTimer();
        }

        function updateFirebaseProgress() {
            if (state.roomRef) {
                state.roomRef.child(`players/${state.playerId}`).update({
                    progress: state.currentQuestionIndex + 1,
                    score: state.score,
                    correct: state.correctCount
                });
            }
        }

        function updateSingleHud() {
            els.progressText.textContent = `第 ${state.currentQuestionIndex + 1} / ${state.totalQuestions} 題`;
            els.currentScore.textContent = state.score;
            els.progressFill.style.width = ((state.currentQuestionIndex) / state.totalQuestions * 100) + '%';
        }

        function startQuestionTimer() {
            state.questionTimeLeft = 8.0;
            updateTimerDisplay();

            clearInterval(state.questionTimer);
            const startTime = Date.now();
            const totalTime = 8000;
            let lastTickSecond = 8;

            state.questionTimer = setInterval(() => {
                const elapsed = Date.now() - startTime;
                state.questionTimeLeft = Math.max(0, (totalTime - elapsed) / 1000);
                updateTimerDisplay();

                // 倒數音效
                const currentSecond = Math.ceil(state.questionTimeLeft);
                if (currentSecond !== lastTickSecond && currentSecond > 0) {
                    lastTickSecond = currentSecond;
                    sfx.tick();
                }

                if (state.questionTimeLeft <= 0) {
                    clearInterval(state.questionTimer);
                    handleTimeout();
                }
            }, 50);
        }

        function updateTimerDisplay() {
            const percent = (state.questionTimeLeft / 8) * 100;
            els.timerFill.style.width = percent + '%';
            els.timerText.textContent = state.questionTimeLeft.toFixed(1) + 's';

            // 計時條顏色過渡
            const color = state.questionTimeLeft > 5
                ? '#22c55e'
                : (state.questionTimeLeft > 2.5 ? '#fbbf24' : '#ef4444');
            els.timerFill.style.backgroundColor = color;
            els.timerText.style.color = color;
        }

        // ==========================================
        // 答題判定
        // ==========================================
        function handleSubmit() {
            if (!state.isAnswering) return;

            const value = parseInt(els.numberInput.value, 10);
            if (isNaN(value) || value < 1 || value > 26) {
                // 抖動警示輸入錯誤
                els.numberInput.style.borderColor = '#ef4444';
                els.numberInput.style.animation = 'shake 0.3s';
                setTimeout(() => {
                    els.numberInput.style.borderColor = '';
                    els.numberInput.style.animation = '';
                }, 300);
                return;
            }

            state.isAnswering = false;
            clearInterval(state.questionTimer);

            if (value === state.currentAnswer) {
                // 答對
                state.score += 10;
                state.correctCount++;
                showFeedback(true, `正確！答案是 ${state.currentAnswer}`);
                sfx.correct();
                spawnParticles(25);
            } else {
                // 答錯
                showFeedback(false, `正確答案是 ${state.currentAnswer}`);
                sfx.wrong();
                els.letterDisplay.style.animation = 'shake 0.4s';
                setTimeout(() => { els.letterDisplay.style.animation = ''; }, 400);
            }

            els.numberInput.disabled = true;
            els.submitBtn.disabled = true;

            // 延遲後自動下一題
            setTimeout(() => {
                hideFeedback();
                state.currentQuestionIndex++;
                nextQuestion();
            }, 1400);
        }

        function handleTimeout() {
            if (!state.isAnswering) return;
            state.isAnswering = false;

            showFeedback(false, `時間到！正確答案是 ${state.currentAnswer}`);
            sfx.wrong();
            els.letterDisplay.style.animation = 'shake 0.4s';
            setTimeout(() => { els.letterDisplay.style.animation = ''; }, 400);

            els.numberInput.disabled = true;
            els.submitBtn.disabled = true;

            setTimeout(() => {
                hideFeedback();
                state.currentQuestionIndex++;
                nextQuestion();
            }, 1400);
        }

        function showFeedback(isCorrect, message) {
            els.feedback.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');
            els.feedback.innerHTML = (isCorrect ? '✅ 答對！' : '❌ 答錯') + `<span class="answer">${message}</span>`;
        }

        function hideFeedback() {
            els.feedback.classList.remove('show');
        }

        // 答對灑花粒子效果
        function spawnParticles(count) {
            const emojis = ['⭐', '✨', '🌟', '💫', '🎉'];
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            for (let i = 0; i < count; i++) {
                setTimeout(() => {
                    const particle = document.createElement('div');
                    particle.className = 'particle';
                    particle.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                    particle.style.left = centerX + 'px';
                    particle.style.top = centerY + 'px';
                    
                    const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.5;
                    const distance = 80 + Math.random() * 160;
                    const tx = Math.cos(angle) * distance;
                    const ty = Math.sin(angle) * distance;
                    
                    particle.style.setProperty('--tx', tx + 'px');
                    particle.style.setProperty('--ty', ty + 'px');
                    document.body.appendChild(particle);
                    setTimeout(() => particle.remove(), 1200);
                }, i * 25);
            }
        }

        // ==========================================
        // 結束畫面成績結算
        // ==========================================
        function showEndScreen(playersData = null) {
            clearInterval(state.questionTimer);
            sfx.end();
            showScreen('endScreen');

            if (state.isMultiplayer && playersData) {
                // 【雙人模式結算】
                els.singleScoreBox.style.display = 'none';
                els.playAgainBtn.style.display = 'none';
                els.battleResultsContainer.style.display = 'flex';
                els.returnLobbyBtn.style.display = 'block';

                const playerIds = Object.keys(playersData);
                const playersList = playerIds.map(id => {
                    const isMe = id === state.playerId;
                    const defaultName = playersData[id].role === 'player1' ? '玩家 1' : '玩家 2';
                    return {
                        id: id,
                        name: isMe ? `${defaultName} (你)` : defaultName,
                        score: playersData[id].score || 0,
                        correct: playersData[id].correct || 0,
                        accuracy: Math.round(((playersData[id].correct || 0) / 10) * 100)
                    };
                });

                // 分數降序排列
                playersList.sort((a, b) => b.score - a.score);

                // 決定冠亞軍稱號
                let titleText = '考試完成！';
                let trophy = '🏆';
                
                if (playersList.length >= 2) {
                    if (playersList[0].score === playersList[1].score) {
                        titleText = '雙方平手！';
                        trophy = '🤝';
                    } else {
                        const winner = playersList[0];
                        titleText = `🎉 恭喜 ${winner.name} 獲勝！`;
                        trophy = winner.id === state.playerId ? '👑' : '🎖️';
                    }
                }

                els.trophyEmoji.textContent = trophy;
                els.endTitle.textContent = titleText;
                els.endMessage.textContent = '全場考試對戰結束！';

                // 渲染對戰成績卡片
                els.battleResultsContainer.innerHTML = '';
                playersList.forEach((p, index) => {
                    const isWinner = index === 0 && (playersList.length < 2 || playersList[0].score !== playersList[1].score);
                    const card = document.createElement('div');
                    card.className = `result-card ${isWinner ? 'winner' : ''}`;
                    card.innerHTML = `
                        <div class="result-header">
                            <span class="result-name">${p.name}</span>
                            <span class="result-score">${p.score} 分</span>
                        </div>
                        <div class="result-stats">
                            <span>答對題數: <span class="result-val" style="color: #22c55e;">${p.correct} / 10</span></span>
                            <span>正確率: <span class="result-val">${p.accuracy}%</span></span>
                        </div>
                    `;
                    els.battleResultsContainer.appendChild(card);
                });

            } else {
                // 【單人模式結算】
                els.singleScoreBox.style.display = 'flex';
                els.playAgainBtn.style.display = 'block';
                els.battleResultsContainer.style.display = 'none';
                els.returnLobbyBtn.style.display = 'none';

                const accuracy = Math.round((state.correctCount / state.totalQuestions) * 100);
                els.finalScore.textContent = state.score;
                els.correctCount.textContent = `${state.correctCount} / ${state.totalQuestions}`;
                els.accuracy.textContent = accuracy + '%';

                let message, title, trophy;
                if (state.correctCount === 10) {
                    trophy = '👑';
                    title = '完美！';
                    message = '太厲害了，全部答對！';
                } else if (state.correctCount >= 8) {
                    trophy = '🏆';
                    title = '表現優異！';
                    message = '很棒的表現，實力堅強！';
                } else if (state.correctCount >= 6) {
                    trophy = '🎖️';
                    title = '不錯！';
                    message = '表現良好，繼續加油！';
                } else if (state.correctCount >= 4) {
                    trophy = '💪';
                    title = '再接再厲！';
                    message = '多練習能更上一層樓！';
                } else {
                    trophy = '📚';
                    title = '加油！';
                    message = '再挑戰一次，熟悉字母順序！';
                }

                els.trophyEmoji.textContent = trophy;
                els.endTitle.textContent = title;
                els.endMessage.textContent = message;
            }
        }

        // ==========================================
        // 事件監聽與初始化
        // ==========================================
        
        // 單人開始測驗
        els.startBtn.addEventListener('click', () => {
            startSinglePlayer();
            // 在點擊的當下立刻同步呼叫對焦，保證手機鍵盤成功彈出
            forceFocusInput();
        });

        // 單人再玩一次
        els.playAgainBtn.addEventListener('click', () => {
            startSinglePlayer();
            forceFocusInput();
        });

        // 雙人進入房間
        els.joinRoomBtn.addEventListener('click', joinRoom);
        
        // 雙人返回大廳
        els.returnLobbyBtn.addEventListener('click', () => {
            leaveRoom();
        });

        // 等待中離開房間
        els.leaveRoomBtn.addEventListener('click', () => {
            leaveRoom();
        });

        // 提交答案
        els.submitBtn.addEventListener('click', handleSubmit);

        // 支援 Enter 鍵直接提交
        els.numberInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                handleSubmit();
            }
        });

        // 防失焦設計：若玩家不小心點到答題畫面其他地方導致鍵盤縮回，點擊畫面任意處立即重新喚醒鍵盤
        els.quizScreen.addEventListener('click', (e) => {
            if (state.isAnswering && e.target !== els.submitBtn && e.target !== els.numberInput) {
                forceFocusInput();
            }
        });

        // 限制房號輸入框僅能輸入 4 位數
        els.roomCodeInput.addEventListener('input', (e) => {
            let value = e.target.value.replace(/[^0-9]/g, '');
            if (value.length > 4) value = value.slice(0, 4);
            e.target.value = value;
        });

        // 限制答題輸入框僅能輸入 2 位數字，且最大值限制為 26
        els.numberInput.addEventListener('input', (e) => {
            let value = e.target.value.replace(/[^0-9]/g, '');
            if (value.length > 2) value = value.slice(0, 2);
            if (parseInt(value, 10) > 26) value = '26';
            e.target.value = value;
        });

        // 初始化背景星星
        createStars();

        // 支援行動端快速觸發 active 樣式
        document.addEventListener('touchstart', function() {}, {passive: true});
    </script>
</body>
</html>
